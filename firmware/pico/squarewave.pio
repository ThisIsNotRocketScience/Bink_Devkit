;
; Based on the squarewave example in pico-examples.
;

.program squarewave
    set pindirs, 1   ; Set pin to output
    
.wrap_target
    set pins, 1      ; Drive pin high
    set pins, 0    ; Drive pin low
.wrap

.program squarewaveslow
    set pindirs, 1   ; Set pin to output
.wrap_target
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 1  [4]   
    set pins, 0  [4]   
    set pins, 0  [4]   
    set pins, 0  [4]   
    set pins, 0  [4]   
    set pins, 0  [4]   
    set pins, 0  [4]   
    set pins, 0  [4]   
.wrap
